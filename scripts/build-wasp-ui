#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
repo="$PWD"
target="$repo/.runtime/wasp-client"
build_fingerprints() (
  cd "$repo"
  node --input-type=module <<'JS'
import { createHash } from 'node:crypto';
import { readFileSync, readdirSync } from 'node:fs';

function files(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap(entry => {
    const path = directory + '/' + entry.name;
    return entry.isDirectory() ? files(path) : entry.isFile() ? [path] : [];
  });
}

const inputs = [
  'scripts/build-wasp-ui', 'scripts/generate-wasp-surfaces.py', 'public/index.html', 'public/stage.html',
  'hub/project-references.mjs',
  'wasp-ui/.wasproot', 'wasp-ui/.waspignore', 'wasp-ui/.npmrc', 'wasp-ui/main.wasp.ts', 'wasp-ui/schema.prisma',
  'wasp-ui/package.json', 'wasp-ui/vite.config.ts', 'wasp-ui/tsconfig.json',
  'wasp-ui/tsconfig.src.json', 'wasp-ui/tsconfig.wasp.json', ...files('wasp-ui/src'),
];
const hash = createHash('sha256');
for (const path of inputs.sort()) {
  hash.update(path + '\0').update(createHash('sha256').update(readFileSync(path)).digest());
}
const source = hash.copy().digest('hex');
const lock = 'wasp-ui/package-lock.json';
hash.update(lock + '\0').update(createHash('sha256').update(readFileSync(lock)).digest());
console.log(source + ':' + hash.digest('hex'));
JS
)
initial_fingerprints=$(build_fingerprints)
fingerprint=${initial_fingerprints#*:}
if [[ "${1:-}" == "--ensure" && -s "$target/index.html" && -s "$target/reference-source.json" && -d "$target/wasp-assets" && -s "$target/source.sha256" ]] \
   && [[ "$fingerprint" == "$(cat "$target/source.sha256")" ]]; then
  exit 0
fi
python3 scripts/generate-wasp-surfaces.py --check
cd wasp-ui
wasp=(npm exec --yes --package=@wasp.sh/wasp-cli@0.26.0 -- wasp)
if [[ ! -d .wasp/spec ]]; then "${wasp[@]}" install; fi
"${wasp[@]}" build
resolved_fingerprints=$(build_fingerprints)
if [[ "${initial_fingerprints%%:*}" != "${resolved_fingerprints%%:*}" ]]; then
  printf '%s\n' 'The Wasp build inputs changed during compilation. Run ./scripts/build-wasp-ui again.' >&2
  exit 1
fi
fingerprint=${resolved_fingerprints#*:}
PATH="$PWD/node_modules/.bin:$PATH" REACT_APP_API_URL=http://127.0.0.1:5780 vite build
dist="$PWD/.wasp/out/web-app/build"
test -s "$dist/200.html"
test -d "$dist/wasp-assets"
mkdir -p "$target/wasp-assets"
node --input-type=module - "$dist/200.html" "$target/index.html.next" <<'JS'
import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { gzipSync } from 'node:zlib';
import { createWaspSourceSnapshot, WASP_SOURCE_SNAPSHOT } from '../hub/project-references.mjs';
const [source, target] = process.argv.slice(2);
const html = readFileSync(source, 'utf8');
const viewport = /<meta\b[^>]*\bname=(["'])viewport\1[^>]*>/gi;
if ([...html.matchAll(viewport)].length !== 1) throw new Error('Expected one Wasp viewport meta tag.');
const index = html.replace(viewport, '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">');
writeFileSync(target, index);
writeFileSync(join(dirname(target), WASP_SOURCE_SNAPSHOT + '.next'), await createWaspSourceSnapshot(index));
const assets = join(dirname(source), 'wasp-assets');
for (const name of readdirSync(assets)) {
  if (!/-[\w-]{8,}\.(?:js|css)$/.test(name)) continue;
  const asset = join(assets, name);
  writeFileSync(asset + '.gz', gzipSync(readFileSync(asset), { level: 9 }));
}
JS
if [[ "$resolved_fingerprints" != "$(build_fingerprints)" ]]; then
  printf '%s\n' 'The Wasp build inputs changed during compilation. Run ./scripts/build-wasp-ui again.' >&2
  exit 1
fi
cp -R "$dist/wasp-assets/." "$target/wasp-assets/"
mv "$target/reference-source.json.next" "$target/reference-source.json"
mv "$target/index.html.next" "$target/index.html"
printf '%s\n' "$fingerprint" > "$target/source.sha256.next"
mv "$target/source.sha256.next" "$target/source.sha256"
